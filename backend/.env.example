# Run uvicorn from the project root so Settings reads root .env.
# Supply your PostgreSQL/Redis DSNs; use TLS and restricted runtime credentials.
DATABASE_URL=
REDIS_URL=
ALLOWED_ORIGINS=["http://localhost:5173"]
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CURSOR_SIGNING_KEY=
REDIS_NAMESPACE=pudi:development
# Production cookie is __Host-pudi_session, HttpOnly; Secure; SameSite=Lax; Path=/.
# For local HTTP development only, the login service may issue this cookie name.
SESSION_COOKIE=pudi_session
